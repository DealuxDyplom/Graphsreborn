<Window x:Class="Graphs.IsothermDataForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
        Title="Редактирование изотерм" Height="650" Width="1000"
        Background="White" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Выберите образец:" Margin="8 2"/>
            <ComboBox x:Name="ComboBox_Isotherm" Grid.Column="1" Margin="4"
                      SelectionChanged="ComboBox_Isotherm_SelectionChanged"/>
            <TextBlock x:Name="TextBlock_Parameters" Grid.Column="2" Margin="12 9"
                       HorizontalAlignment="Right" Foreground="#555"/>
        </Grid>
        <DataGrid x:Name="DataGrid_Points" Grid.Row="1" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  RowEditEnding="DataGrid_Points_RowEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Aисх" Width="*" Binding="{Binding InitialOpticalDensity, StringFormat=0.#####}"/>
                <DataGridTextColumn Header="C0, мкмоль/л" Width="*" IsReadOnly="True" Binding="{Binding InitialConcentrationUmolL, StringFormat=0.#####}"/>
                <DataGridTextColumn Header="m, г" Width="*" Binding="{Binding SorbentMassG, StringFormat=0.#####}"/>
                <DataGridTextColumn Header="Aравн" Width="*" Binding="{Binding EquilibriumOpticalDensity, StringFormat=0.#####}"/>
                <DataGridTextColumn Header="Ce, мкмоль/л" Width="*" Binding="{Binding Ce, StringFormat=0.#####}"/>
                <DataGridTextColumn Header="qe, мкг/г" Width="*" IsReadOnly="True" Binding="{Binding CapacityUgG, StringFormat=0.#####}"/>
                <DataGridTextColumn Header="qe, мкмоль/г" Width="*" Binding="{Binding Qe, StringFormat=0.#####}"/>
                <DataGridTextColumn Header="%" Width="*" IsReadOnly="True" Binding="{Binding RemovalPercent, StringFormat=0.###}"/>
            </DataGrid.Columns>
        </DataGrid>
        <WindowsFormsHost x:Name="chartHost" Grid.Row="2">
            <wf:Chart x:Name="Graph_Isotherm"
                      MouseDown="Graph_Isotherm_MouseDown"
                      MouseMove="Graph_Isotherm_MouseMove"
                      MouseUp="Graph_Isotherm_MouseUp"/>
        </WindowsFormsHost>
        <TextBlock x:Name="TextBlock_EditStatus" Grid.Row="3" Margin="10 5" Foreground="#555"
                   Text="Перемещение qe пересчитывает Aравн, Ce, qe (мкг/г) и извлечение %. Для старых файлов без исходных A и массы изменяются только Ce–qe."/>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Сохранить изменения" Margin="18 9" Click="Button_Save_Click"/>
            <Button Grid.Column="1" Content="Вернуть исходные значения" Margin="18 9" Click="Button_Reset_Click"/>
            <Button Grid.Column="2" Content="Закрыть без сохранения" Margin="18 9" Click="Button_Cancel_Click"/>
        </Grid>
    </Grid>
</Window>

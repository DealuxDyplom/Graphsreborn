<Window x:Class="Graphs.IsothermDataForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
        Title="Данные изотермы" Height="680" Width="900"
        Background="White" Closed="Window_Closed">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0 0 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Название образца:" VerticalContentAlignment="Center"/>
            <TextBox x:Name="TextBox_Name" Grid.Column="1" Margin="6" MinWidth="220"/>
            <Label Grid.Column="2" Content="Температура, °C:" VerticalContentAlignment="Center"/>
            <TextBox x:Name="TextBox_Temperature" Grid.Column="3" Margin="6" Text="20" MinWidth="90"/>
        </Grid>
        <DataGrid x:Name="DataGrid_Points" Grid.Row="1"
                  AutoGenerateColumns="False" CanUserAddRows="True"
                  CanUserDeleteRows="True" HeadersVisibility="Column"
                  RowEditEnding="DataGrid_Points_RowEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ce, мкмоль/л" Width="*"
                                    Binding="{Binding Ce, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="qe, мкмоль/г" Width="*"
                                    Binding="{Binding Qe, UpdateSourceTrigger=PropertyChanged}"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Margin="0 7 0 5" Foreground="#555"
                   Text="Перетащите экспериментальную точку вверх или вниз — Ce останется неизменной, qe обновится в таблице."/>
        <WindowsFormsHost x:Name="chartHost" Grid.Row="3">
            <wf:Chart x:Name="Graph_Isotherm"
                      MouseDown="Graph_Isotherm_MouseDown"
                      MouseMove="Graph_Isotherm_MouseMove"
                      MouseUp="Graph_Isotherm_MouseUp"/>
        </WindowsFormsHost>
        <Grid Grid.Row="4" Margin="0 8 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Сохранить в сессии" Grid.Column="0" Margin="70 3" Click="Button_Save_Click"/>
            <Button Content="Отмена" Grid.Column="1" Margin="70 3" Click="Button_Cancel_Click"/>
        </Grid>
    </Grid>
</Window>

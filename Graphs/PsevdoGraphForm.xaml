<Window x:Class="Graphs.PsevdoGraphForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wf="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
        xmlns:local="clr-namespace:Graphs"
        mc:Ignorable="d"
        Title="PsevdoGraphForm" Height="450" Width="800" Closed="Window_Closed">
    <DockPanel>
        <Grid x:Name="Grid_Main">
            <Grid x:Name="Graphs_Psevdo">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>
                <Label x:Name="Label_PsevdoGraph_Name" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0"/>
                <WindowsFormsHost Name="chartHost" Grid.Row="1" Grid.Column="0">
                    <wf:Chart x:Name="Graph_PsevdoChart"/>

                </WindowsFormsHost>
                <Grid x:Name="Grid_PsevdoParam" Grid.Row="2" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Y=" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0"/>
                    <Label x:Name="Label_Qe" Content="" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <Label Content="Детерминация" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="2" Grid.Row="0"/>
                    <Label x:Name="Label_K" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="2" Grid.Row="1"/>
                    <TextBox x:Name="TextBox_Equastion" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" IsReadOnly="True" MinWidth="150"/>
                    <TextBox x:Name="TextBox_R2" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" IsReadOnly="True" MinWidth="150"/>
                    <TextBox x:Name="TextBox_Qe" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" IsReadOnly="True" MinWidth="150"/>
                    <TextBox x:Name="TextBox_K" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" IsReadOnly="True" MinWidth="150"/>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

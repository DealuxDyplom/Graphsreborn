<Window x:Class="Graphs.EditSubstanceForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wf="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
        xmlns:local="clr-namespace:Graphs"
        mc:Ignorable="d"
        Title="EditSubstanceForm" Height="450" Width="800">
    <DockPanel>
        <Grid x:Name="Grid_Main">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Grid x:Name="Grid_SubstanceTable" Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="Grid_SubstanceName" Grid.Row="0" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Выберите раствор:" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
                    <ComboBox x:Name="ComboBox_SubstanceName" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="0" Grid.Column="1" Width="150" SelectionChanged="ComboBox_SubstanceName_SelectionChanged"/>
                </Grid>
                <DataGrid x:Name="DataGrid_Substance" Grid.Row="1" Grid.Column="0" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="обр\врем" Width="*" Binding="{Binding Path=time}"/>
                        <DataGridTextColumn Header="m, г" Width="*" Binding="{Binding Path=m_r}"/>
                        <DataGridTextColumn Header="A" Width="*" Binding="{Binding Path=A}"/>
                        <DataGridTextColumn Header="С,мкг/мл" Width="*" Binding="{Binding Path=C_mkmol}"/>
                        <DataGridTextColumn Header="qt, мкг/г" Width="*" Binding="{Binding Path=qt_mr}"/>
                        <DataGridTextColumn Header="qt, μмоль/г" Width="*" Binding="{Binding Path=qt_ml}"/>
                        <DataGridTextColumn Header="%" Width="*" Binding="{Binding Path=proc}"/>
                        <DataGridTextColumn Header="qe-qt" Width="*" Binding="{Binding Path=qe_qt}"/>
                        <DataGridTextColumn Header="log(qe-qt)" Width="*" Binding="{Binding Path=log_qe_qt}"/>
                        <DataGridTextColumn Header="t\qt" Width="*" Binding="{Binding Path=t_qt}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid x:Name="Grid_SubstanceGraph" Grid.Row="1" Grid.Column="0">
                <WindowsFormsHost Name="chartHost" Grid.Row="0" Grid.Column="0">
                    <wf:Chart x:Name="Graph_Substance" MouseDown="Graph_Substance_MouseDown" MouseMove="Graph_Substance_MouseMove" MouseUp="Graph_Substance_MouseUp"/>

                </WindowsFormsHost>
            </Grid>
            <Grid x:Name="Grid_Buttons" Grid.Row="2" Grid.Column="0">
                <Button x:Name="Button_SaveEditSubstance" Content="Сохранить изменения" MaxWidth="500" Margin="50 10" Click="Button_SaveEditSubstance_Click"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

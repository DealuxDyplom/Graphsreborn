<Window x:Class="Graphs.KineticModelTableForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Graphs"
        mc:Ignorable="d"
        Title="Кинетические модели — линеаризация" Height="500" Width="1050" Background="White" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="BorderCell">
            <Setter Property="Control.BorderBrush" Value="Black"/>
            <Setter Property="Control.BorderThickness" Value="1 1 0 0"/>
        </Style>
        <Style x:Key="BorderCellEnd">
            <Setter Property="Control.BorderBrush" Value="Black"/>
            <Setter Property="ItemsControl.BorderThickness" Value="1 1 1 0"/>
        </Style>
        <Style x:Key="BorderCellEndEnd">
            <Setter Property="Control.BorderBrush" Value="Black"/>
            <Setter Property="ItemsControl.BorderThickness" Value="1 1 1 1"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Grid x:Name="Grid_Main" Background="White">
            <Grid x:Name="Grid_ModelKin">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="Grid_Header" Grid.Row="0" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource BorderCell}">
                        <Label Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Label.Content>
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center">Модель кинетики</TextBlock>
                            </Label.Content>
                        </Label>
                    </Border>
                    <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource BorderCell}">
                        <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Label.Content>
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center">Образец</TextBlock>
                            </Label.Content>
                        </Label>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource BorderCell}">
                        <Label Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Label.Content>
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center">Уравнение прямой</TextBlock>
                            </Label.Content>
                        </Label>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource BorderCell}">
                        <Label Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Label.Content>
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center">qₑ, мкмоль/г</TextBlock>
                            </Label.Content>
                        </Label>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource BorderCell}">
                        <Label Grid.Row="0" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label.Content>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">k₁, мин⁻¹ / k₂, г·мкмоль⁻¹·мин⁻¹</TextBlock>
                        </Label.Content>
                    </Label>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="5" Style="{StaticResource BorderCellEnd}">
                        <Label Grid.Row="0" Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Label.Content>
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center">R² линеаризации</TextBlock>
                            </Label.Content>
                        </Label>
                    </Border>
                </Grid>
                <ScrollViewer Grid.Row="1" Grid.Column="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="Grid_PsevdoParam">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource BorderCellEnd}">
                        <Grid x:Name="Grid_Psevdo_1" Grid.Row="0" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label.Content>
                                    <TextBlock TextWrapping="Wrap" TextAlignment="Center">Псевдо-первый порядок</TextBlock>
                                </Label.Content>
                            </Label>
                            <Grid x:Name="Grid_Psevdo_1_Param" Grid.Row="0" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource BorderCellEndEnd}">
                        <Grid x:Name="Grid_Psevdo_2" Grid.Row="1" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Label.Content>
                                        <TextBlock TextWrapping="Wrap" TextAlignment="Center">Псевдо-второй порядок</TextBlock>
                                    </Label.Content>
                                </Label>
                                <Grid x:Name="Grid_Psevdo_2_Param" Grid.Row="0" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                </ScrollViewer>
                <!--<Grid x:Name="Grid_Psevdo_1" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" ShowGridLines="true">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Label.Content>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">Псевдо-первый порядок</TextBlock>
                        </Label.Content>
                    </Label>
                </Grid>-->
                <!--<Grid x:Name="Grid_Psevdo_2" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" ShowGridLines="true">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Label.Content>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">Псевдо-второй порядок</TextBlock>
                        </Label.Content>
                    </Label>
                </Grid>-->
            </Grid>
        </Grid>
    </DockPanel>
</Window>

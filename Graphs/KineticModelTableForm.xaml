<Window x:Class="Graphs.KineticModelTableForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Graphs"
        mc:Ignorable="d"
        Title="KineticModelTableForm" Height="450" Width="800" Closed="Window_Closed">
    <DockPanel>
        <Grid x:Name="Grid_Main">
            <Grid x:Name="Grid_ModelKin" ShowGridLines="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="Grid_Header" Grid.Row="0" Grid.Column="0" ShowGridLines="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label.Content>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">Модель кинетики</TextBlock>
                        </Label.Content>
                    </Label>
                    <Label Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label.Content>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">Образец</TextBlock>
                        </Label.Content>
                    </Label>
                    <Label Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label.Content>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">Уравнение аппроксимации</TextBlock>
                        </Label.Content>
                    </Label>
                    <Label Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label.Content>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">qe, (мкмоль/г)</TextBlock>
                        </Label.Content>
                    </Label>
                    <Label Grid.Row="0" Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label.Content>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">K1, (мин^-1)</TextBlock>
                        </Label.Content>
                    </Label>
                    <Label Grid.Row="0" Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Label.Content>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">R^2</TextBlock>
                        </Label.Content>
                    </Label>
                </Grid>
                <Grid x:Name="Grid_PsevdoParam" Grid.Row="1" Grid.Column="0" ShowGridLines="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="Grid_Psevdo_1" Grid.Row="0" Grid.Column="0" ShowGridLines="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Label.Content>
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center">Псевдо-первый порядок</TextBlock>
                            </Label.Content>
                        </Label>
                        <Grid x:Name="Grid_Psevdo_1_Param" Grid.Row="0" Grid.Column="1" ShowGridLines="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Grid>
                    <Grid x:Name="Grid_Psevdo_2" Grid.Row="1" Grid.Column="0" ShowGridLines="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Label.Content>
                                <TextBlock TextWrapping="Wrap" TextAlignment="Center">Псевдо-второй порядок</TextBlock>
                            </Label.Content>
                        </Label>
                        <Grid x:Name="Grid_Psevdo_2_Param" Grid.Row="0" Grid.Column="1" ShowGridLines="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Grid>
                </Grid>
                <!--<Grid x:Name="Grid_Psevdo_1" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" ShowGridLines="true">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Label.Content>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">Псевдо-первый порядок</TextBlock>
                        </Label.Content>
                    </Label>
                </Grid>-->
                <!--<Grid x:Name="Grid_Psevdo_2" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" ShowGridLines="true">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Label.Content>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">Псевдо-второй порядок</TextBlock>
                        </Label.Content>
                    </Label>
                </Grid>-->
            </Grid>
        </Grid>
    </DockPanel>
</Window>

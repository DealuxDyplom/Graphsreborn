<Window x:Class="Graphs.IsothermGraphForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wf="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
        Title="Изотерма Langmuir — линеаризация" Height="560" Width="950" Closed="Window_Closed">
    <DockPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="125"/>
            </Grid.RowDefinitions>
            <Label x:Name="Label_GraphName" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <WindowsFormsHost Grid.Row="1">
                <wf:Chart x:Name="Graph_LangmuirChart"/>
            </WindowsFormsHost>
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Уравнение" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_Equation" Grid.Column="1" IsReadOnly="True" MinWidth="150" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Label Content="R² линеаризации" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_R2" Grid.Column="3" IsReadOnly="True" MinWidth="150" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Label Content="qmax, мкмоль/г" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_Qmax" Grid.Row="1" Grid.Column="1" IsReadOnly="True" MinWidth="150" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Label Content="KL, л/мкмоль" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_KL" Grid.Row="1" Grid.Column="3" IsReadOnly="True" MinWidth="150" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Label Content="Статус" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_Status" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" IsReadOnly="True" MinWidth="470" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

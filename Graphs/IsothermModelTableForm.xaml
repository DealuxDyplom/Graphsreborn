<Window x:Class="Graphs.IsothermModelTableForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Модели изотерм — линеаризация" Height="360" Width="1170"
        Background="White" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="HeaderBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1 1 0 1"/>
        </Style>
        <Style x:Key="HeaderBorderEnd" TargetType="Border">
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1 1 1 1"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Grid Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource HeaderBorder}"><Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><TextBlock Text="Модель изотермы" TextWrapping="Wrap" TextAlignment="Center"/></Label></Border>
                <Border Grid.Column="1" Style="{StaticResource HeaderBorder}"><Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><TextBlock Text="Образец" TextWrapping="Wrap" TextAlignment="Center"/></Label></Border>
                <Border Grid.Column="2" Style="{StaticResource HeaderBorder}"><Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><TextBlock Text="Уравнение прямой" TextWrapping="Wrap" TextAlignment="Center"/></Label></Border>
                <Border Grid.Column="3" Style="{StaticResource HeaderBorder}"><Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><TextBlock Text="qmax, мкмоль/г" TextWrapping="Wrap" TextAlignment="Center"/></Label></Border>
                <Border Grid.Column="4" Style="{StaticResource HeaderBorder}"><Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><TextBlock Text="KL, л/мкмоль" TextWrapping="Wrap" TextAlignment="Center"/></Label></Border>
                <Border Grid.Column="5" Style="{StaticResource HeaderBorder}"><Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><TextBlock Text="R² линеаризации" TextWrapping="Wrap" TextAlignment="Center"/></Label></Border>
                <Border Grid.Column="6" Style="{StaticResource HeaderBorderEnd}"><Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center"><TextBlock Text="Статус" TextWrapping="Wrap" TextAlignment="Center"/></Label></Border>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border BorderBrush="Black" BorderThickness="1 0 1 1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">
                            <TextBlock Text="Langmuir" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Label>
                        <Grid x:Name="Grid_LangmuirParam" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>

<Window x:Class="Graphs.AddSubstanceForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wf="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
        xmlns:local="clr-namespace:Graphs"
        mc:Ignorable="d"
        Title="AddSubstanceForm" Height="543" Width="925">
    <Grid x:Name="Grid_Main">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid x:Name="Grid_GraduationTable" Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Градуирвка:" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <ComboBox x:Name="ComboBox_Graduation" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" MinWidth="150">

            </ComboBox>
            <DataGrid x:Name="DataGrid_Graduation" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="С,мкг/мл" Width="*" Binding="{Binding Path=C_mkmol}"/>
                    <DataGridTextColumn Header="А (361 нм)" Width="*" Binding="{Binding Path=A}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Grid x:Name="Grid_ExprData" Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <Grid x:Name="Grid_ExprDataParam" Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Название раствора:" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_SubstanceName" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" MinWidth="150"/>
                <Label Content="Оптическая плотность раствора(А):" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_OpticDens" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" MinWidth="150"/>
            </Grid>
            <DataGrid x:Name="DataGrid_ExprData" CanUserAddRows="True" CanUserDeleteRows="True" Grid.Row="1" Grid.Column="0" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="обр/врем" Width="*" Binding="{Binding Path=time}"/>
                    <DataGridTextColumn Header="m, г" Width="*" Binding="{Binding Path=m_r}"/>
                    <DataGridTextColumn Header="A" Width="*" Binding="{Binding Path=A}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid x:Name="Grid_ExprDataButtons" Grid.Row="2" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="Button_FillExprDataFromFile" Content="Заполнить из файла" Margin="20 5 20 5" Grid.Row="0" Grid.Column="0" Click="Button_FillExprDataFromFile_Click"/>
                <Button x:Name="Button_SaveExprDataIntoFile" Content="Сохранить в файл" Margin="20 5 20 5" Grid.Row="0" Grid.Column="1" Click="Button_SaveExprDataIntoFile_Click"/>
            </Grid>
        </Grid>
        <Grid x:Name="Grid_GraduationGraph" Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <WindowsFormsHost Name="chartHost" Grid.Row="0" Grid.Column="0">
                <wf:Chart x:Name="Chart_Graduation"/>

            </WindowsFormsHost>
            <Grid x:Name="Grid_GraduationGraphParam" Grid.Row="1" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Label Content="Коэффициент::" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_Coef" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" MinWidth="150" IsReadOnly="True"/>
                <Label Content="Детерминация:" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox x:Name="TextBox_Detr" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" MinWidth="150" IsReadOnly="True"/>
            </Grid>
        </Grid>
        <Grid x:Name="Grid_Data" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="DataGrid_Data" IsReadOnly="True" AutoGenerateColumns="False" Grid.Row="0" Grid.Column="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="обр\врем" Width="*" Binding="{Binding Path=time}"/>
                    <DataGridTextColumn Header="m, г" Width="*" Binding="{Binding Path=m_r}"/>
                    <DataGridTextColumn Header="A" Width="*" Binding="{Binding Path=A}"/>
                    <DataGridTextColumn Header="С,мкг/мл" Width="*" Binding="{Binding Path=C_mkmol}"/>
                    <DataGridTextColumn Header="qt, мкг/г" Width="*" Binding="{Binding Path=qt_mr}"/>
                    <DataGridTextColumn Header="qt, μмоль/г" Width="*" Binding="{Binding Path=qt_ml}"/>
                    <DataGridTextColumn Header="%" Width="*" Binding="{Binding Path=proc}"/>
                    <DataGridTextColumn Header="qe-qt" Width="*" Binding="{Binding Path=qe_qt}"/>
                    <DataGridTextColumn Header="log(qe-qt)" Width="*" Binding="{Binding Path=log_qe_qt}"/>
                    <DataGridTextColumn Header="t\qt" Width="*" Binding="{Binding Path=t_qt}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid x:Name="Grid_DataButtons" Grid.Row="1" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="Button_AddSubstance" Content="Добавить" Margin="50 5 50 5" Grid.Row="0" Grid.Column="0" Click="Button_AddSubstance_Click"/>
                <Button x:Name="Button_Recalculate" Content="Пересчитать" Margin="50 5 50 5" Grid.Row="0" Grid.Column="1" Click="Button_Recalculate_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>

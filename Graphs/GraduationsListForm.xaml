<Window x:Class="Graphs.GraduationsListForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Graphs"
        mc:Ignorable="d"
        Title="GraduationsListForm" Height="450" Width="800" Closed="Window_Closed">
    <DockPanel>
        <Grid x:Name="Grid_Main">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <GroupBox Header="Список градуировок" Grid.Row="0" Grid.Column="0">
                <WrapPanel x:Name="WrapPanel_Graduations" Orientation="Vertical"/>
            </GroupBox>
            <DataGrid x:Name="DataGrid_Graduation" AutoGenerateColumns="False" Grid.Row="1" Grid.Column="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="С,мкг/мл" Width="*" Binding="{Binding Path=C_mkmol}"/>
                    <DataGridTextColumn Header="А (361 нм)" Width="*" Binding="{Binding Path=A}"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid x:Name="Grid_Buttons" Grid.Row="2" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="Button_AddGraduation" Content="Добавить градуировку" Grid.Row="0" Grid.Column="0" Margin="20 10" Click="Button_AddGraduation_Click"/>
                <Button x:Name="Button_SaveEdits" Content="Соханить изменения" Grid.Row="0" Grid.Column="1" Margin="20 10" Click="Button_SaveEdits_Click"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

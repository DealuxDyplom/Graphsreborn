<Window x:Class="Graphs.AddGraduationForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Graphs"
        mc:Ignorable="d"
        Title="AddGraduationForm" Height="450" Width="800" Closed="Window_Closed">
    <DockPanel>
        <Grid x:Name="Grid_Main">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>
            <Grid x:Name="Grid_GraduationName" Grid.Row="0" Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Название градуировки:" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0"/>
                <TextBox x:Name="TextBox_GraduationName" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="0" Grid.Column="1" MinWidth="350"/>
            </Grid>
            <Grid Grid.Row="1" Grid.Column="0">
                <DataGrid x:Name="DataGrid_Graduation" Grid.Row="0" Grid.Column="0" AutoGenerateColumns="false">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="С,мкг/мл" Width="*" Binding="{Binding Path=C_mkmol}"/>
                        <DataGridTextColumn Header="А (361 нм)" Width="*" Binding="{Binding Path=A}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid x:Name="Grid_Buttons" Grid.Row="2" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="Button_FillFromFileGraduation" Content="Заполнить из файла" Grid.Row="0" Grid.Column="0" Width="350" Height="30" Click="Button_FillFromFileGraduation_Click"/>
                <Button x:Name="Button_AddGraduation" Content="Добавить градуировку" Grid.Row="1" Grid.Column="0" Margin="50 10" Click="Button_AddGraduation_Click"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
